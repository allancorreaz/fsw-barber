generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  OWNER
  MANAGER
  RECEPTIONIST
  BARBER
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum SubscriptionStatus { PENDING ACTIVE PAST_DUE CANCELLED EXPIRED SUSPENDED }
enum BillingCycle { MONTHLY QUARTERLY YEARLY }
enum PaymentPurpose { SAAS_SUBSCRIPTION CONSUMER_PLAN SERVICE }
enum PaymentStatus { PENDING CONFIRMED FAILED REFUNDED CANCELLED }

model User {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bookings      Booking[]
  memberships   BarbershopMember[]
  accounts      Account[]
  sessions      Session[]
  consumerSubscriptions ConsumerSubscription[]
  payments BillingPayment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Barbershop {
  id          String              @id @default(uuid())
  name        String
  address     String
  phones      String[]
  description String
  imageUrl    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  services    BarbershopService[]
  members     BarbershopMember[]
  professionals Professional[]
  publicListingApproved Boolean @default(false)
  googlePlaceId String?
  googleReviewCount Int?
  timezone String @default("America/Sao_Paulo")
  saasSubscription SaasSubscription?
  consumerPlans ConsumerPlan[]
  consumerSubscriptions ConsumerSubscription[]
  payments BillingPayment[]
}

model BarbershopMember {
  id          String       @id @default(uuid())
  userId      String
  barbershopId String
  role        MemberRole
  status      MemberStatus @default(INVITED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@index([barbershopId, status, role])
  @@index([userId, status])
}

model Professional {
  id           String              @id @default(uuid())
  barbershopId String
  userId       String?
  name         String
  email        String?
  phone        String?
  imageUrl     String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  barbershop   Barbershop          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  services     ProfessionalService[]
  workingHours ProfessionalWorkingHour[]
  timeOff      ProfessionalTimeOff[]
  bookings     Booking[]

  @@index([barbershopId, active])
  @@index([userId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model ProfessionalWorkingHour {
  id             String       @id @default(uuid())
  professionalId String
  weekDay        Int
  startTime      String
  endTime        String
  active         Boolean      @default(true)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, weekDay, active])
}

model ProfessionalTimeOff {
  id             String       @id @default(uuid())
  professionalId String
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([professionalId, startsAt, endsAt])
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  price        Decimal    @db.Decimal(10, 2)
  durationMinutes Int     @default(30)
  active       Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  professionals ProfessionalService[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]
  planServices ConsumerPlanService[]
}

model Booking {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  serviceId       String
  service         BarbershopService @relation(fields: [serviceId], references: [id])
  professionalId  String?
  professional    Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  date            DateTime
  status          BookingStatus     @default(REQUESTED)
  priceAtBooking  Decimal?          @db.Decimal(10, 2)
  durationMinutes Int?
  customerNotes   String?
  internalNotes   String?
  payments        BillingPayment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([date, status])
  @@index([professionalId, date, status])
  @@index([userId, date])
  @@index([serviceId, date])
}

model SaasPlan {
  id String @id @default(uuid())
  name String @unique
  description String?
  price Decimal @db.Decimal(10,2)
  cycle BillingCycle @default(MONTHLY)
  active Boolean @default(true)
  features Json
  subscriptions SaasSubscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SaasSubscription {
  id String @id @default(uuid())
  barbershopId String @unique
  planId String
  status SubscriptionStatus @default(PENDING)
  amount Decimal @db.Decimal(10,2)
  cycle BillingCycle
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  gateway String?
  gatewayCustomerId String?
  gatewaySubscriptionId String? @unique
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  plan SaasPlan @relation(fields: [planId], references: [id])
  payments BillingPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, currentPeriodEnd])
}
model ConsumerPlan {
  id String @id @default(uuid())
  barbershopId String
  name String
  description String?
  price Decimal @db.Decimal(10,2)
  cycle BillingCycle @default(MONTHLY)
  active Boolean @default(true)
  services ConsumerPlanService[]
  subscriptions ConsumerSubscription[]
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([barbershopId, name])
  @@index([barbershopId, active])
}
model ConsumerPlanService {
  planId String
  serviceId String
  plan ConsumerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([planId, serviceId])
  @@index([serviceId])
}
model ConsumerSubscription {
  id String @id @default(uuid())
  userId String
  barbershopId String
  planId String
  status SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  plan ConsumerPlan @relation(fields: [planId], references: [id])
  payments BillingPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, barbershopId, status])
  @@index([planId, status])
}
model BillingPayment {
  id String @id @default(uuid())
  purpose PaymentPurpose
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(10,2)
  currency String @default("BRL")
  gateway String?
  gatewayPaymentId String? @unique
  idempotencyKey String? @unique
  saasSubscriptionId String?
  consumerSubscriptionId String?
  bookingId String?
  barbershopId String?
  userId String?
  paidAt DateTime?
  saasSubscription SaasSubscription? @relation(fields: [saasSubscriptionId], references: [id], onDelete: SetNull)
  consumerSubscription ConsumerSubscription? @relation(fields: [consumerSubscriptionId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  barbershop Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([purpose, status, createdAt])
  @@index([barbershopId, purpose, status])
}
model GatewayWebhookEvent {
  id String @id @default(uuid())
  gateway String
  eventId String
  eventType String
  payload Json
  processedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([gateway, eventId])
  @@index([processedAt, createdAt])
}
