# ---------------------------------------------------------------------------
# Banco de dados (Neon)
# ---------------------------------------------------------------------------
# Conexão pooled, usada pela aplicação (tem "-pooler" no host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Conexão direta, usada pelo Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# Endereço público do site, sem barra no final. Usado nos retornos do pagamento e no webhook.
APP_URL="https://seu-projeto.vercel.app"
# Segredo para cifrar tokens do Mercado Pago no banco e assinar o OAuth. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ATENÇÃO: se trocar depois, as barbearias precisam reconectar o Mercado Pago.
APP_SECRET=""
# E-mails (separados por vírgula) com acesso ao painel /admin da plataforma.
PLATFORM_ADMIN_EMAILS="voce@exemplo.com"
# Segredo da rotina diária (/api/cron/billing). A Vercel envia automaticamente.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Mensalidade da plataforma (o que as barbearias pagam para você)
# ---------------------------------------------------------------------------
SAAS_MONTHLY_PRICE="79.90"
SAAS_TRIAL_DAYS="14"
# Dias de tolerância após o vencimento antes de suspender a barbearia.
SAAS_GRACE_DAYS="5"

# ---------------------------------------------------------------------------
# Pagamentos
# ---------------------------------------------------------------------------
# Provedor ativo. Hoje: "mercadopago". Preparado para "celcoin" (ver app/_lib/payments).
PAYMENT_PROVIDER="mercadopago"
# Credenciais da SUA aplicação no painel "Suas integrações" do Mercado Pago.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Access Token da SUA conta (recebe a mensalidade das barbearias).
MP_PLATFORM_ACCESS_TOKEN=""
# Assinatura secreta dos webhooks (Suas integrações → Webhooks).
MP_WEBHOOK_SECRET=""
# "true" enquanto estiver testando com contas de teste do Mercado Pago.
MP_TEST_MODE="true"
